# ============================================================
# 数据调度平台 (DSP) - Git 忽略规则
# ============================================================

# ---------- 数据库 ----------
data/*.db
data/*.db-shm
data/*.db-wal
data/demo.db

# ---------- 日志 ----------
logs/
*.log

# ---------- 输出文件 ----------
data/outputs/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---------- 虚拟环境 ----------
venv/
env/
ENV/
.venv/

# ---------- 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 临时文件 ----------
*.tmp
*.bak
*.old
~$*.xlsx
~$*.xls

# ---------- 环境变量 / 密钥 ----------
config.py
.env
.env.local
.env.*.local
secrets.py
